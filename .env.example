# =============================================================================
# Variaveis de Ambiente: Wamini Pro
# =============================================================================

# Chave secreta de autenticacao local (obrigatorio: minimo 32 caracteres)
JWT_SECRET=wamini_secret_key_producao_super_segura_32_chars_2026

# URL publica da aplicacao em producao (ex: https://wamini-pro.vercel.app)
NEXT_PUBLIC_APP_URL=https://wamini-pro.vercel.app

# Rota base da API
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Base de Dados Turso (Obrigatorio na Vercel / Producao Serverless)
# Crie a base de dados gratuita em https://turso.tech
TURSO_DATABASE_URL=libsql://sua-base-de-dados.turso.io
TURSO_AUTH_TOKEN=seu_token_de_autenticacao_turso

# Vercel Blob Storage: Upload de fotos de produtos e documentos (Opcional)
# Criado automaticamente ao ativar o Vercel Blob no painel da Vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
